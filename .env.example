DATABASE_URL=file:local.db
ENABLE_DEMO_USER=false
# Trust these only when the app is reachable exclusively through that proxy chain.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
PUBLIC_COMMIT_HASH=
PUBLIC_GIT_REPO_ID=sachahjkl/albumator
# Configures Node.js body parser limit, see https://svelte.dev/docs/kit/adapter-node#environment-variables-body-size-limit
BODY_SIZE_LIMIT=100M
IMAGE_CACHE_DIR=image-cache
IMAGE_CACHE_MAX_BYTES=1073741824
IMAGE_CACHE_MAX_AGE_SECONDS=2592000
IMAGE_CACHE_CLEANUP_INTERVAL_SECONDS=3600
