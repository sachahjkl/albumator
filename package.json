{
	"name": "albumator",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"validate": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run build",
		"images:backfill": "tsx ./src/lib/server/images/backfill.ts",
		"images:cache:stats": "tsx ./src/lib/server/images/cacheStats.ts",
		"db:gen": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:up": "drizzle-kit up",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"drizzle-orm": "^0.45.2",
		"sharp": "^0.35.1",
		"thumbhash": "^0.1.1",
		"virtua": "^0.49.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^26.0.0",
		"drizzle-kit": "^0.31.10",
		"image-type": "^6.1.0",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"runed": "^0.37.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"svelte-copy": "^2.0.0",
		"svelte-persisted-store": "^0.12.0",
		"tailwindcss": "^4.3.1",
		"ts-debounce": "^5.0.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.8.0"
}
